{
    "name": "cataglyph",
    "version": "0.3.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "description": "Desktop app to cull a folder of new photos with an on-device model and archive the keepers as JPEG XL.",
    "scripts": {
        "build": "bun run scripts/build.ts",
        "dev": "bun run scripts/dev.ts",
        "dev:hmr": "bun run scripts/dev.ts --hmr",
        "package": "bun run scripts/package.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.view.json && vite build --logLevel warn",
        "test": "bun test",
        "vendor": "bun run scripts/fetch-vendor.ts"
    },
    "dependencies": {
        "@desert-ant-labs/eye": "4.1.0",
        "exiftool-vendored": "39.0.1",
        "jpeg-js": "0.4.4",
        "koffi": "2.16.3",
        "libheif-js": "1.23.5"
    },
    "devDependencies": {
        "@electron/packager": "20.3.0",
        "@types/bun": "latest",
        "@vitejs/plugin-vue": "6.0.10",
        "electron": "44.9.3",
        "typescript": "^5.9.0",
        "vite": "8.3.5",
        "vue": "3.6.0-rc.13",
        "vue-tsc": "3.3.13"
    },
    "trustedDependencies": [
        "koffi"
    ]
}
